{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ibat-mozkan",
  "account_id": "df414b176985bb15c627a0ac1f82e85d",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "ibat.mozkan.com.tr",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
